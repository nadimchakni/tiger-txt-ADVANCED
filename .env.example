# Copy this to .env and fill in your values (never commit .env)

# Telegram Bot API credentials (from my.telegram.org)
API_ID=22609670
API_HASH=your_api_hash_here

# Bot token from @BotFather (San_Down_Bot)
BOT_TOKEN=your_bot_token_here

# Your Telegram user ID (becomes OWNER, auto-added to ADMINS)
OWNER=your_telegram_id_here

# Space-separated extra admin IDs (optional)
ADMINS=

# Log channel ID (negative number for supergroups)
LOG=

# Thrill World passdb
PASS_DB=721
